# Copy to .env and fill in. Never commit the real .env.
PORT=5001
# SQLite file relative to prisma/schema.prisma
DATABASE_URL="file:./dev.db"
# Any long random string, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
JWT_SECRET=""
CORS_ORIGIN="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"

# Optional: AI assistant (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Optional: real payments via Stripe test mode
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
